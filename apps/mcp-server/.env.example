# URL apps/worker (Cloudflare) -- WAJIB, tiap tool MCP manggil Worker lewat ini.
WORKER_URL=https://<nama-worker-anda>.workers.dev

# URL publik deployment apps/mcp-server ini sendiri -- dipakai sbg
# issuer/base utk metadata OAuth discovery. Kalau kosong, di-derive dari
# Request yg masuk (cukup utk dev lokal, WAJIB diisi eksplisit di
# production Vercel supaya konsisten).
APP_URL=http://localhost:3000

{
  "name": "financial-app",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:desktop": "npm run tauri dev --workspace=desktop",
    "build:desktop": "npm run tauri build --workspace=desktop",
    "dev:mobile": "npm run start --workspace=mobile",
    "test:desktop": "npm run test --workspace=desktop",
    "test:desktop:watch": "npm run test:watch --workspace=desktop",
    "import:money-manager": "npm run import:money-manager --prefix internal",
    "import:money-manager:dry-run": "npm run import:money-manager:dry-run --prefix internal"
  }
}
